# Config for run-scheduled-backup.sh. Install as /etc/backup/backup.conf (root-owned, 600).
# This file is sourced by bash, so use bash syntax.

RCLONE_REMOTE="gdrive-crypt"
RCLONE_CONFIG_FILE="/home/turing/.config/rclone/rclone.conf"

# Directories to back up. Each one gets its own folder and snapshot on the remote.
BACKUP_DIRS=(
  /mnt/vault/share
  /mnt/vault/immich
  /mnt/vault/nextcloud
  /home/turing
)

STOP_DOCKER=yes                              # stop Docker during the backup
DOCKER_UNITS=(docker.socket docker.service)
ATTEMPTS=2                                   # tries per directory

LOG_FILE="/var/log/backup/scheduled-backup.log"
STATUS_FILE="/var/lib/backup/last-run.status"

# --- Notifications (ntfy) ---
# Leave NTFY_URL empty to turn notifications off.
NTFY_URL=""                     # e.g. "https://ntfy.sh/<your-private-topic>"
NTFY_TOKEN=""                   # only for protected topics / self-hosted ntfy
NTFY_NOTIFY_ON="all"            # all = success + failure | failure | none
# Failure covers: a folder failed, Docker couldn't be stopped, or Docker didn't restart.

# --- Optional custom hooks ---
# Called with one message argument, in addition to ntfy. Define only if needed.
# on_backup_success() { :; }
# on_backup_failure() { :; }
